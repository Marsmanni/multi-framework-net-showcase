<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UI_Sample_API</RootNamespace>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.AspNetCore.OpenApi</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI-Sample-API.Shared\UI-Sample-API.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
  </ItemGroup>

  <!-- Write git commit short SHA to publish folder so InfoController can read it at runtime -->
  <Target Name="WriteGitCommitFile" BeforeTargets="Publish">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShort" />
    </Exec>

    <PropertyGroup>
      <_GitCommitVal>$(GitCommitShort)</_GitCommitVal>
      <_GitCommitVal Condition="'$(_GitCommitVal)' == ''">unknown</_GitCommitVal>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(PublishDir)git-commit.txt"
      Lines="$(_GitCommitVal)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

</Project>
