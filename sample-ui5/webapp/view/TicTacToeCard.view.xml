<mvc:View
	controllerName="com.24steps.ui5sample.controller.TicTacToe"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc">
	
	<f:Card class="sapUiSmallMargin" width="350px">
		<f:header>
			<card:Header
				xmlns:card="sap.f.cards"
				title="{i18n>ticTacToeTitle}"
				subtitle="{i18n>ticTacToeSubtitle}" />
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" alignItems="Center">
				<HBox class="sapUiTinyMarginBottom">
					<Label text="{i18n>currentPlayerLabel}" class="sapUiTinyMarginEnd" />
					<Text text="{ticTacToe>/currentPlayer}" />
				</HBox>
				<Text text="{ticTacToe>/gameStatus}" class="sapUiSmallMarginBottom" />
				
				<!-- Game Board -->
				<l:Grid
					defaultSpan="XL4 L4 M4 S4"
					width="300px"
				vSpacing="0"
				hSpacing="0"
				containerQuery="true"
				class="ticTacToeGrid sapUiSmallMarginBottom">
					<Button
						text="{ticTacToe>/board/0}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="0" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/1}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="1" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/2}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="2" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/3}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="3" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/4}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="4" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/5}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="5" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/6}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="6" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/7}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="7" />
						</customData>
					</Button>
					<Button
						text="{ticTacToe>/board/8}"
						width="90px"
						press=".onButtonCellPress"
						class="ticTacToeCell">
						<customData>
							<core:CustomData key="index" value="8" />
						</customData>
					</Button>
			</l:Grid>

			<HBox class="sapUiSmallMarginTop">
				<Button
					text="{i18n>resetGameButton}"
					icon="sap-icon://refresh"
					press=".onResetGameButtonPress"
					type="Emphasized"
					class="sapUiTinyMarginEnd" />
				<Button
					text="{i18n>computerStartsButton}"
					icon="sap-icon://user-settings"
					press=".onComputerStartsButtonPress"
					type="Default" />
			</HBox>
		</VBox>
		</f:content>
	</f:Card>
	
</mvc:View>
