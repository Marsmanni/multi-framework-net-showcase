{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Type": "Bearer",
    "Authority": "https://your-identity-server.com",
    "Audience": "your-api-audience"
  },
  "ApiDocumentation": {
    "UseScalar": true,
    "UseSwagger": true
  }
}
